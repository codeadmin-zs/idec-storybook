{
  "name": "@mygarage/design-tokens",
  "version": "1.0.0",
  "description": "Design tokens (color, type, spacing, radii, shadow, motion) for the My Garage design system — distributed as CSS custom properties, SCSS, and JS/TS.",
  "license": "UNLICENSED",
  "private": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./css": "./dist/css/variables.css",
    "./scss": "./dist/scss/_variables.scss",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/tokens.json",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["design-tokens", "design-system", "css-variables", "scss", "mygarage"]
}
